# Streamlit Community Cloud / ローカル用 秘密情報の雛形
# このファイルをコピーして「secrets.toml」という名前にして使う（secrets.toml は Git に含めない）。
# Streamlit Cloud では、この内容を管理画面の「Settings → Secrets」に貼り付ける。

# Gemini API キー（必須：リアルタイム対話を使う場合）
GEMINI_API_KEY = "AIzaSy...ここに自分のキー..."

# 公開URLでのAPI浪費を防ぐパスワード（推奨：設定するとリアルタイム対話にパスワードが必要になる）
APP_PASSWORD = "好きな合言葉"

# 使用モデルの上書き（任意・カンマ区切り）
# GEMINI_MODEL_CANDIDATES = "gemini-2.5-flash,gemini-3.1-flash-lite"
